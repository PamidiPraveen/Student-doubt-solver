# Local development environment template
# Copy to backend/.env and replace the placeholder secrets.
# Never commit backend/.env to GitHub.

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters-long

# Minutes a login stays valid (there is no refresh token). Default 60.
# JWT_ACCESS_TOKEN_MINUTES=60

# Optional: defaults to a local SQLite database. Use PostgreSQL in production.
# DATABASE_URL=sqlite:///instance/app.db

# Browser origins allowed to call the API (comma separated).
# Not needed if the frontend and API share one origin behind a proxy.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true only when running behind exactly one reverse proxy.
# TRUST_PROXY=false

# Optional: configure a shared rate-limit store for production.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# LOGIN_RATE_LIMIT=10 per minute
# REGISTER_RATE_LIMIT=10 per hour

# Subjects offered in the interface (comma separated).
# SUBJECTS=Mathematics,Physics,Chemistry

# AI suggestions: Gemini is used when enabled and a key is configured.
# Otherwise the local TF-IDF engine is used.
# AI_ENABLED=true
# AI_USE_GEMINI=true
# AI_SIMILARITY_THRESHOLD=0.2
# AI_MAX_SUGGESTIONS=5
# AI_GEMINI_TIMEOUT=8

# Content moderation. Abusive questions and answers are blocked and the
# author gets a notification. The local filter needs no key. Add a Gemini
# key to also check with AI (optional).
# MODERATION_ENABLED=true
# GEMINI_API_KEY=
# MODERATION_USE_GEMINI=true
# GEMINI_MODEL=gemini-2.5-flash
# MODERATION_STRICTNESS=strict      # strict: mild insults and any hostile tone are rejected
# MODERATION_FAIL_CLOSED=false      # if Gemini is down: true refuses posts; false uses the local word filter
# MODERATION_TIMEOUT=8
